# Copy to .env and fill in. NEVER commit the real .env (see .gitignore).

# Freshdesk
FRESHDESK_DOMAIN=simployer          # -> https://simployer.freshdesk.com
FRESHDESK_API_KEY=                   # SERVICE account key that POSTS the notes; base64(apikey + ":X")
MY_AGENT_ID=                         # comma-separated NAMED monitored agent ids (key owner may differ)
EXPECTED_AGENT_NAME=Tobias Carneteg  # best-effort startup check; ids remain authoritative

# Freshworks CRM (optional, read-only; separate from the Freshdesk key)
FRESHWORKS_CRM_ENABLED=false
FRESHWORKS_CRM_BASE_URL=https://simployer.myfreshworks.com/crm/sales/api
FRESHWORKS_CRM_API_KEY=
# Tenant schema verified in the live Freshworks module on 2026-07-30. These are
# optional overrides; the Edge Function uses the same values by default.
FRESHWORKS_CRM_SUBSCRIPTIONS_PATH=/custom_module/cm_subscription/view/31008500658?q[]=%7B%22name%22%3A%22cf_account_number%22%2C%22operator%22%3A4%2C%22value%22%3A%22{account_id}%22%2C%22domType%22%3A6%7D
FRESHWORKS_CRM_SUBSCRIPTIONS_COLLECTION=cm_subscription
FRESHWORKS_CRM_ACCOUNT_FIELD=cf_account_number
# Exact approved fields shown in the private note and Coach Review.
FRESHWORKS_CRM_PRODUCT_FIELD=cf_product_name
FRESHWORKS_CRM_RENEWAL_STATUS_FIELD=cf_renewal_status
FRESHWORKS_CRM_END_DATE_FIELD=cf_end_date

# LLM (OpenAI — the three reasoning calls: analyse / draft / verify)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Function guard (pg_cron sends this as the x-cron-secret header)
CRON_SECRET=

# Supabase (injected automatically when deployed; set locally to persist
# `deno task replay` results into `suggestions` so you can set verdicts + read
# gate1_scorecard). SUPABASE_URL = https://<project-ref>.supabase.co
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Tuning (optional)
MAX_PER_RUN=5                    # queued ticket events processed per invocation
BOOTSTRAP_LOOKBACK_MINUTES=60    # first run only; later runs use the durable DB cursor
POLL_STREAM=ticket-suggester-v1  # cursor/queue/lease namespace
POLL_LEASE_SECONDS=180           # prevents overlapping cron runs
WITH_RETRIEVAL=true    # false = skip KB search (Step 2, minimal end-to-end)
DRY_RUN=true           # safe default; false enables Freshdesk note/tag writes
REVIEW_APP_URL=        # authenticated Coach Review URL; new notes link here

# Replay safety (optional)
REPLAY_APPROVED=false  # first run previews ids/subjects and exits; set true after approval
CLOUD_LOG_MODE=        # set to safe in cloud CI to suppress ticket/customer/agent text
# KB categories/folders to exclude from retrieval (comma-separated, case-insensitive).
# e.g. keep Norwegian "Expert NO" content out of Swedish/English suggestions.
EXCLUDE_SOLUTION_CATEGORIES=Expert NO
