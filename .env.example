# Copy to .env and fill in. NEVER commit the real .env (see .gitignore).

# Freshdesk
FRESHDESK_DOMAIN=simployer          # -> https://simployer.freshdesk.com
FRESHDESK_API_KEY=                   # SERVICE account key that POSTS the notes; base64(apikey + ":X")
MY_AGENT_ID=                         # MONITORED agent whose tickets we watch (may differ from the key owner)
EXPECTED_AGENT_NAME=Tobias Carneteg  # name of the monitored agent; best-effort startup check

# Claude
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5

# Function guard (pg_cron sends this as the x-cron-secret header)
CRON_SECRET=

# Supabase (injected automatically when deployed; set locally for `deno task serve`)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Tuning (optional)
MAX_PER_RUN=5          # tickets processed per invocation
LOOKBACK_MINUTES=5     # updated_since window; overlap is fine, dedup handles it
WITH_RETRIEVAL=true    # false = skip KB search (Step 2, minimal end-to-end)
